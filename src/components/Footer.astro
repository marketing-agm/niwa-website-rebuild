---
import Wordmark from './Wordmark.astro';
import { formatPhone } from '../lib/site';
const { site } = Astro.props as { site: any };
const c = site.config;
const a = c.address;
const year = new Date().getFullYear();
const hours = c.contact?.officeHours?.[0];
const fmtHour = (t: string) => { const [h] = t.split(':').map(Number); return `${((h + 11) % 12) + 1}${h < 12 ? 'am' : 'pm'}`; };
const links = [
  ['#building', 'The building'],
  ['#floor-plans', 'The homes'],
  ['#availability', 'Availability'],
  ['#neighborhood', 'Queen Anne'],
  ['#faq', 'Questions'],
  ['#tour', 'Schedule a tour'],
];
---
<footer class="foot" id="contact">
  <div class="foot-mark" data-footer-mark>
    <Wordmark class="foot-svg" label="Niwa Apartments" />
  </div>
  <div class="foot-lines">
    <p class="foot-line foot-line--lead">
      {c.name} is at <a class="link" href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${c.name}, ${a.streetAddress}, ${a.addressLocality}, ${a.addressRegion} ${a.postalCode}`)}`} target="_blank" rel="noopener">{a.streetAddress}, {a.addressLocality}, {a.addressRegion} {a.postalCode}</a>.
      Call <a class="link" href={c.contact?.phoneHref}>{formatPhone(c.contact?.phone)}</a> or write to <a class="link" href={`mailto:${c.contact?.email}`}>{c.contact?.email}</a>.
    </p>
    <p class="foot-line">
      {hours && <>The leasing office is open Monday to Friday, {fmtHour(hours.opens)} to {fmtHour(hours.closes)}. </>}
      After hours, call <a class="link" href={c.contact?.afterHours?.phoneHref}>{formatPhone(c.contact?.afterHours?.phone)}</a> and the Facilities Team will pick up.
    </p>
    <nav class="foot-nav" aria-label="Sections">
      {links.map(([href, label]) => <a class="link" href={href}>{label}</a>)}
    </nav>
    <p class="foot-line foot-legal small">
      <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 11.5 12 4l9 7.5M5 10v10h14V10M9 20v-6h6v6"/></svg>
      Equal Housing Opportunity. MFTE, MHA and ADA homes available. © {year} {c.name}. {c.footerBlurb}
      <a class="link foot-top" href="#top">Back to top ↑</a>
    </p>
  </div>
</footer>

<style>
  .foot { background: var(--bg); color: var(--fg); border-top: 1px solid var(--line); }
  .foot-mark { padding: clamp(40px, 6vw, 110px) var(--gutter) clamp(28px, 4vw, 72px); }
  .foot-mark :global(.foot-svg) { width: 100%; height: auto; color: var(--fg); stroke-width: 22; }
  .foot-lines { padding: clamp(24px, 3vw, 48px) var(--inset) clamp(28px, 3vw, 48px); border-top: 1px solid var(--line); display: grid; gap: clamp(14px, 1.6vw, 24px); }
  .foot-line { max-width: 80ch; text-wrap: pretty; color: var(--fg-2); line-height: 1.55; }
  .foot-line--lead { font-size: var(--t-lead); color: var(--fg); max-width: 40ch; line-height: 1.3; }
  .foot-line--lead .link:hover { color: var(--gold); }
  .foot-nav { display: flex; flex-wrap: wrap; gap: 8px clamp(18px, 2vw, 32px); padding: clamp(10px, 1.2vw, 18px) 0; border-top: 1px solid var(--line-2); border-bottom: 1px solid var(--line-2); font-size: var(--t-small); }
  .foot-legal { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; max-width: none; color: var(--fg-3); }
  .foot-legal svg { flex: none; }
  .foot-top { margin-left: auto; color: var(--fg-2); }
  .foot-top:hover { color: var(--gold); }
</style>
