---
import Wordmark from './Wordmark.astro';
import { formatPhone, mapsUrl } from '../lib/site';
// The wordmark is the end of the homepage's long scroll and earns its size
// there. On a secondary page it is the thing that arrives right after the last
// row of content, where seven hundred pixels of it reads as a hole rather than
// a flourish — so those pages ask for it smaller.
const { site, compact = false } = Astro.props as { site: any; compact?: boolean };
const c = site.config;
const a = c.address;
const year = new Date().getFullYear();
const hours = c.contact?.officeHours?.[0];
const fmtHour = (t: string) => { const [h] = t.split(':').map(Number); return `${((h + 11) % 12) + 1}${h < 12 ? 'am' : 'pm'}`; };
---
<footer class:list={['foot', compact && 'foot--compact']} id="contact">
  <div class="foot-mark" data-footer-mark>
    <Wordmark class="foot-svg" label="Niwa Apartments" />
  </div>
  <div class="grid foot-grid">
    <div class="cell foot-cell">
      <span class="label label--dim">Address</span>
      <p>
        <a class="link foot-addr" href={mapsUrl(c)} target="_blank" rel="noopener"
           aria-label={`Open ${a.streetAddress}, ${a.addressLocality} in Google Maps`}
        >{a.streetAddress}<br />{a.addressLocality}, {a.addressRegion} {a.postalCode}</a>
      </p>
      <p class="small">{a.placename}</p>
    </div>
    <div class="cell foot-cell">
      <span class="label label--dim">Leasing</span>
      <p><a class="link" href={c.contact?.phoneHref}>{formatPhone(c.contact?.phone)}</a></p>
      <p><a class="link" href={`mailto:${c.contact?.email}`}>{c.contact?.email}</a></p>
    </div>
    <div class="cell foot-cell">
      <span class="label label--dim">Hours</span>
      {hours && <p>Monday – Friday<br />{fmtHour(hours.opens)} – {fmtHour(hours.closes)}</p>}
      <p class="small">After hours: <a class="link" href={c.contact?.afterHours?.phoneHref}>{formatPhone(c.contact?.afterHours?.phone)}</a></p>
    </div>
    <div class="cell foot-cell">
      <span class="label label--dim">Sections</span>
      <ul class="foot-links">
        <li><a class="link" href="#building">The building</a></li>
        <li><a class="link" href="#floor-plans">The homes</a></li>
        <li><a class="link" href="#availability">Availability</a></li>
        <li><a class="link" href="#neighborhood">Queen Anne</a></li>
        <li><a class="link" href="#tour">Schedule a tour</a></li>
      </ul>
    </div>
  </div>
  <div class="foot-bar">
    <p class="label label--dim">© {year} {c.name}. {c.footerBlurb}</p>
    <p class="label label--dim foot-eho">
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 11.5 12 4l9 7.5M5 10v10h14V10M9 20v-6h6v6"/></svg>
      Equal Housing Opportunity · MFTE / MHA and ADA homes available
    </p>
    <a class="label label--dim foot-top" href="#top">Back to top ↑</a>
  </div>
</footer>

<style>
  .foot { background: var(--bg); color: var(--fg); border-top: 1px solid var(--line); }
  .foot-mark { padding: clamp(40px, 6vw, 110px) var(--gutter) clamp(28px, 4vw, 72px); }
  .foot--compact .foot-mark { padding: clamp(24px, 3vw, 52px) var(--gutter) clamp(20px, 2.4vw, 40px); }
  .foot--compact .foot-mark :global(.foot-svg) { max-width: min(100%, 700px); }
  /* Full measure, at the drawing's own stroke weight. The mark is the last
     thing on the page and it is the name of the building, so it takes the
     width it is given; the gutter on .foot-mark is what keeps it off the
     edges, and that gutter scales with the screen, so the mark scales with
     it on every size from a phone to a television. No height ceiling: the
     mark is wide and short, so on any real screen the width is what rules,
     and a vh ceiling only ever fired on a short window to shrink it for no
     reason. */
  .foot-mark :global(.foot-svg) { width: 100%; height: auto; margin: 0 auto; color: var(--fg); stroke-width: 22; }
  .foot-cell { grid-column: span 3; display: grid; gap: 10px; align-content: start; font-size: var(--t-body); }
  .foot-links { display: grid; gap: 6px; }
  .foot-bar { display: flex; justify-content: space-between; gap: var(--gap); flex-wrap: wrap; padding: clamp(16px, 1.6vw, 26px) var(--inset) clamp(24px, 2.4vw, 40px); }
  .foot-bar p { max-width: 70ch; }
  .foot-eho { display: inline-flex; align-items: center; gap: 8px; }
  .foot-top { transition: color 0.3s; } .foot-top:hover { color: var(--gold); }
  @media (max-width: 900px) { .foot-cell { grid-column: span 6; } }
  @media (max-width: 520px) { .foot-cell { grid-column: 1 / -1; } .foot-bar { flex-direction: column; } }
  /* The phone and email here are how someone actually reaches the building
     from a phone, so they get a real press target rather than an 18px line. */
  @media (pointer: coarse) {
    .foot-cell a[href^="tel:"], .foot-cell a[href^="mailto:"] {
      display: inline-flex; align-items: center; min-height: 44px;
    }
  }
  /* The footer takes the nav's treatment rather than the body's: nothing at
     rest, a gold rule drawing in from the left on hover. Same gesture as THE
     IDEA up top, so the two ends of the page agree.

     Done with the link's own gradient rather than a ::after, because the
     address wraps to two lines and an absolutely positioned bar can only ever
     underline one of them. background-size animates per line fragment, so both
     lines draw together. */
  .foot :global(.link) { --link-rule: var(--gold); background-size: 0 1px; background-position: 0 100%; }
  /* The cell warms to gold under the pointer, so the rule drawn on top of it
     is ink. Gold on gold is the disappearing act this whole treatment exists
     to avoid. */
  .foot :global(.cell:hover .link) { --link-rule: var(--ink); }
  @media (hover: hover) {
    .foot :global(.link:hover) { background-size: 100% 1px; }
  }
  @media (hover: none) {
    /* No hover to reveal them, so on touch they keep a resting rule. */
    .foot :global(.link) { --link-rule: currentColor; background-size: 100% 1px; }
  }

</style>
