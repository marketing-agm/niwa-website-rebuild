---
// The unit-type gallery: an irregular grid with hairline rules between cells.
//
// The rhythm is fixed (see SPANS in lib/unitPhotos.ts) rather than derived per
// photo, which is what keeps it from turning into a ragged masonry wall — every
// gallery has the same eight-cell tile, so the composition is designed once and
// the pictures move through it.
import { Image, getImage } from 'astro:assets';
import { unitCells, SPANS, type Cell } from '../lib/unitPhotos';

const { unitKey, unitName } = Astro.props as { unitKey: string; unitName: string };
const cells: Cell[] = unitCells(unitKey);

// A large rendition per photo for the lightbox, resolved at build time so the
// viewer is not loading the cropped grid thumbnail blown up.
const full = await Promise.all(
  cells.map((c) => (c.kind === 'photo' ? getImage({ src: c.photo.img, width: 1800, format: 'webp', quality: 82 }) : null)),
);
const sizes = '(max-width: 640px) 50vw, (max-width: 1100px) 50vw, 40vw';
---
<div class="ug" data-lbx-group={`unit-${unitKey}`} aria-label={`${unitName} photography`}>
  {cells.map((c, i) => {
    const [cs, rs] = SPANS[i % SPANS.length];
    const style = `--cs:${cs};--rs:${rs}`;
    if (c.kind === 'note') {
      return (
        <div class="ug-cell ug-note" style={style} data-wide>
          <span class="label label--dim">{c.label}</span>
          <p class="ug-note-body">{c.body}</p>
        </div>
      );
    }
    return (
      <button
        type="button"
        class="ug-cell ug-photo"
        style={style}
        data-wide={cs >= 4 ? '' : undefined}
        data-lbx-open
        data-lbx-src={full[i]!.src}
        data-lbx-title={c.photo.title}
        data-lbx-desc={c.photo.desc}
        data-lbx-alt={c.photo.alt}
        aria-label={`View ${c.photo.title} full size`}
      >
        <Image src={c.photo.img} alt={c.photo.alt} widths={[400, 700, 1100]} sizes={sizes} format="webp" quality={76} />
        <span class="ug-cap label">{c.photo.title}</span>
      </button>
    );
  })}
</div>

<style>
  /* Hairlines are the 1px gap showing the container's line colour through —
     the same trick the page grid uses, so the rules match the rest of the site
     rather than being borders that double up at every shared edge. */
  .ug {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-auto-rows: minmax(96px, 17vh);
    gap: 1px;
    background: var(--line);
    border-block: 1px solid var(--line);
  }
  .ug-cell {
    grid-column: span var(--cs);
    grid-row: span var(--rs);
    position: relative;
    min-width: 0;
    background: var(--bg);
    overflow: hidden;
  }

  .ug-photo { padding: 0; border: 0; cursor: pointer; display: block; }
  .ug-photo :global(img) {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease), opacity 0.5s var(--ease);
  }
  .ug-photo:hover :global(img) { transform: scale(1.04); }
  .ug-photo:focus-visible { outline: 2px solid var(--gold); outline-offset: -4px; }

  /* The caption sits on the picture, so it needs its own ground rather than
     relying on whatever happens to be behind it. */
  /* A scrim rather than a text shadow: these photos are bright and a shadow
     alone does not hold a label over a white kitchen wall. */
  .ug-photo::after {
    content: ''; position: absolute; inset: auto 0 0 0; height: 68%;
    background: linear-gradient(180deg,
      rgba(11,11,11,0) 0%,
      rgba(11,11,11,0.16) 38%,
      rgba(11,11,11,0.55) 72%,
      rgba(11,11,11,0.9) 100%);
    pointer-events: none;
  }
  .ug-cap {
    position: absolute; left: 14px; right: 14px; bottom: 11px;
    color: var(--paper); text-align: left;
    text-shadow: 0 1px 10px rgba(11, 11, 11, 0.55);
    transition: opacity 0.4s var(--ease);
  }
  .ug-photo:hover .ug-cap, .ug-photo:focus-visible .ug-cap { opacity: 1; }

  .ug-note {
    background: var(--bg-2);
    padding: clamp(16px, 1.6vw, 26px);
    display: grid; gap: 10px; align-content: center;
  }
  .ug-note-body { font-size: var(--t-small); color: var(--fg-2); line-height: 1.5; text-wrap: pretty; }

  /* A six-column irregular grid at phone width is unreadable, so it folds to
     two columns. The wide cells (the 4-span photo and the note) keep the full
     row, which preserves the irregularity — eight cells still tile exactly. */
  @media (max-width: 640px) {
    .ug { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: minmax(112px, 19vh); }
    .ug-cell { grid-column: span 1; grid-row: span 1; }
    .ug-cell[data-wide] { grid-column: span 2; }
    .ug-cap { left: 11px; right: 11px; bottom: 9px; }
  }

  @media (hover: none) {
    .ug-photo:hover :global(img) { transform: none; }
  }
</style>
