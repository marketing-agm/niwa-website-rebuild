---
// The Niwa wordmark, redrawn as four monoline strokes with round caps: the
// same construction as the brand artwork, at 1KB instead of 148KB, and
// drawable with DrawSVG because it is real geometry, not a traced outline.
//
// Letter spacing is optical: the gap between neighbouring strokes is measured
// at mid-height, where the slanted W and A legs sit, so N·I, I·W and W·A read
// as the same distance.
const { class: cls = '', label = 'Niwa Apartments', decorative = false } = Astro.props as {
  class?: string; label?: string; decorative?: boolean;
};
---
<svg
  class={`wordmark ${cls}`}
  viewBox="0 0 560 200"
  fill="none"
  stroke="currentColor"
  stroke-width="26"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={decorative ? undefined : 'img'}
  aria-label={decorative ? undefined : label}
  aria-hidden={decorative ? 'true' : undefined}
  focusable="false"
>
  <path data-stroke d="M22 178V22l128 156V22" />
  <path data-stroke d="M208 22v156" />
  <path data-stroke d="M256 22l34 156 34-156 34 156 34-156" />
  <path data-stroke d="M412 178l56-156 56 156" />
</svg>
