---
const { site } = Astro.props as { site: any };
const c = site.config;
const h = c.hero ?? {};
const a = c.address;
const v = h.video ?? {};
const special = c.special ?? {};
const facts = [
  ['Walk Score', String(c.walkScores?.walk ?? '')],
  ['Homes on floors', '2–8'],
  ['Distinct layouts', '19'],
  ['Pets', 'Welcome'],
];
---
<section class="hero" id="top" data-hero>
  <div class="hero-top">
    <p class="label" data-hero-fade>{a.streetAddress}, {a.addressLocality}</p>
    <button type="button" class="label hero-top-r hero-special" data-hero-fade data-special-toggle aria-haspopup="dialog" aria-expanded="false" aria-controls="special-pop">{special.label}</button>
  </div>

  <h1 class="h1 hero-title" data-hero-title>
    <span class="hero-line"><span class="hero-line-in">{h.title}</span></span>
    <span class="hero-line"><span class="hero-line-in">{h.titleItalic}</span></span>
  </h1>

  <div class="hero-row">
    <p class="lead hero-intro" data-hero-fade>{h.intro}</p>
    <div class="hero-cta" data-hero-fade>
      <a class="btn" href="#tour">Schedule a tour <span class="arr" aria-hidden="true">→</span></a>
      <a class="btn btn--ghost" href="#floor-plans">See the homes</a>
    </div>
    <dl class="hero-facts" data-hero-fade>
      {facts.map(([k, v]) => (
        <div class="hero-fact"><dt class="label label--dim">{k}</dt><dd class="mono">{v}</dd></div>
      ))}
    </dl>
  </div>

  <div class="hero-media" data-hero-media>
    <div class="hero-media-clip">
      <video
        class="hero-video"
        data-hero-img
        data-hero-video
        data-rate={v.playbackRate ?? 0.6}
        autoplay muted loop playsinline disablepictureinpicture
        preload="metadata"
        poster={v.poster}
        aria-label={h.alt}
      >
        {(v.loop ?? []).map((s: any) => <source src={s.src} type={s.type} />)}
      </video>
      <div class="hero-shade" aria-hidden="true"></div>
    </div>
  </div>
</section>

<div class="special-pop" id="special-pop" role="dialog" aria-label={special.title} data-special-pop hidden>
  <span class="label special-eyebrow">{special.eyebrow}</span>
  <p class="special-title">{special.title}</p>
  <p class="small special-note">{special.note}</p>
  <div class="special-actions">
    <a class="btn btn--sm" href="#floor-plans" data-special-close>Explore homes</a>
    <a class="btn btn--ghost btn--sm" href="#tour" data-special-close>Contact us</a>
  </div>
  <button type="button" class="special-x" aria-label="Close" data-special-close>✕</button>
</div>

<style>
  .hero { position: relative; padding-top: clamp(28px, 4vw, 64px); }
  .hero-top { display: flex; justify-content: space-between; gap: var(--gap); padding: 0 var(--inset) clamp(24px, 4.5vw, 80px); }
  .hero-top-r { text-align: right; }
  .hero-title { padding: 0 var(--inset); display: grid; }
  .hero-title .hero-line { display: block; overflow: hidden; padding-bottom: 0.06em; margin-bottom: -0.06em; }
  .hero-line-in { display: block; will-change: transform; }
  .hero-title .hero-line:nth-child(2) { font-style: italic; font-weight: 400; padding-left: clamp(0px, 14vw, 22vw); }
  @media (max-width: 1024px) { .hero-title .hero-line:nth-child(2) { padding-left: 8vw; } }
  .hero-row {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--gap); align-items: end;
    padding: clamp(28px, 4vw, 64px) var(--inset) clamp(28px, 3.4vw, 56px);
  }
  .hero-intro { grid-column: 1 / span 5; max-width: 26ch; }
  .hero-cta { grid-column: 6 / span 3; display: flex; flex-wrap: wrap; gap: 10px; align-self: end; }
  .hero-facts { grid-column: 9 / span 4; display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); margin: 0; }
  .hero-fact { background: var(--bg); padding: clamp(12px, 1.2vw, 18px) clamp(14px, 1.3vw, 22px) clamp(14px, 1.4vw, 22px); display: grid; gap: 6px; transition: background-color 0.28s cubic-bezier(0.2, 0, 0, 1), color 0.28s cubic-bezier(0.2, 0, 0, 1); }
  .hero-fact:hover { background: var(--gold); transition-duration: 0.55s; }
  .hero-special { color: var(--gold); cursor: pointer; text-align: right; padding: 4px 0; transition: opacity 0.3s; }
  .hero-special:hover { opacity: 0.8; }
  .hero-special[aria-expanded="true"] { opacity: 0.8; }
  .special-pop { position: fixed; z-index: 70; width: min(360px, calc(100vw - 2 * var(--gutter))); background: var(--bg); color: var(--fg); border: 1px solid var(--gold); border-radius: 12px; padding: 22px 24px 24px; display: grid; gap: 8px; box-shadow: 0 24px 60px rgba(0,0,0,0.5); }
  .special-pop[hidden] { display: none; }
  .special-eyebrow { color: var(--gold); }
  .special-title { font-size: var(--t-h3); line-height: 1.05; letter-spacing: -0.03em; font-weight: 500; margin-top: 4px; }
  .special-note { color: var(--fg-2); }
  .special-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .special-x { position: absolute; top: 10px; right: 12px; width: 32px; height: 32px; color: var(--fg-2); font-size: 14px; }
  .special-x:hover { color: var(--fg); }
  .hero-fact dd { margin: 0; color: var(--fg); }
  .hero-media { position: relative; }
  .hero-media-clip { height: clamp(300px, 66vh, 960px); overflow: hidden; }
  .hero-media-clip { position: relative; }
  .hero-video { width: 100%; height: 118%; object-fit: cover; object-position: 50% 45%; margin-top: -9%; will-change: transform; background: var(--bg-2); }
  .hero-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(11,11,11,0.55) 0%, rgba(11,11,11,0.28) 45%, rgba(11,11,11,0.6) 100%); pointer-events: none; }
  .hero-media { border-bottom: 1px solid var(--line); }

  @media (max-width: 1024px) {
    .hero-intro { grid-column: 1 / span 7; }
    .hero-cta { grid-column: 8 / span 5; justify-content: flex-end; }
    .hero-facts { grid-column: 1 / -1; grid-template-columns: repeat(4, 1fr); }
  }
  @media (max-width: 720px) {
    .hero-top { flex-direction: column; gap: 6px; }
    .hero-top-r { text-align: left; }
    /* 44px of pressable height; it was 22 and it opens a dialog. */
    .hero-special { text-align: left; padding: 12px 0; margin: -12px 0; }
    .hero-intro, .hero-cta { grid-column: 1 / -1; justify-content: flex-start; }
    .hero-facts { grid-template-columns: repeat(2, 1fr); }
    /* The CTAs are the point of the hero — full width, and side by side only
       while they both still fit. */
    .hero-cta { gap: 10px; }
    .hero-cta .btn { flex: 1 1 auto; justify-content: center; }
  }

  /* Phones. The composition was tight for two reasons that compound: the
     italic second line carries a 10vw indent, which at 390px leaves "Seattle."
     almost no track to sit in, and the block padding is still tuned for a
     desktop measure. Indent goes, rhythm comes back. */
  @media (max-width: 560px) {
    .hero { padding-top: 20px; }
    .hero-top { padding: 0 var(--gutter) 28px; }
    .hero-title { padding: 0 var(--gutter); }
    .hero-title .hero-line:nth-child(2) { padding-left: 0; }
    .hero-row { padding: 32px var(--gutter) 34px; gap: 26px; }
    .hero-intro { max-width: none; }
    .hero-facts { border-left: 0; border-right: 0; }
    .hero-fact { padding: 14px var(--gutter) 16px; }
    /* 66vh of video pushes everything below it off a short screen. */
    .hero-media-clip { height: clamp(260px, 46vh, 420px); }
  }
</style>
