---
const { site } = Astro.props as { site: any };
const items: { q: string; a: string }[] = site.faq ?? [];
---
{items.length > 0 && (
<section class="section faq" id="faq">
  {/* The head reads as a title row, the way every other section on the page
      does — heading left, the note and the button right — rather than a
      narrow sticky column beside a list. With the list folded the old layout
      left two thirds of the row empty. */}
  <div class="faq-grid">
    <div class="faq-side">
      <h2 class="h2" data-reveal>Asked <em>often.</em></h2>
      <p class="body faq-note" data-reveal>Anything else? The leasing team is available during office hours, or leave a note with your tour request.</p>
      {/* The ten questions are a long block to walk past on the way to the
          tour form, so they fold behind this. Collapsed, not removed: the
          answers stay in the markup, which is what the FAQ structured data
          and anyone searching the page are reading. */}
      <button type="button" class="btn btn--ghost btn--sm faq-cta" aria-expanded="false" aria-controls="faq-list" data-faq-all>
        <span data-faq-all-label>Read the questions</span> <span class="arr" aria-hidden="true">→</span>
      </button>
    </div>
    <ol class="faq-list" id="faq-list" hidden>
      {items.map((it, i) => (
        <li class="faq-item" data-reveal>
          <button type="button" class="faq-q" aria-expanded="false" aria-controls={`faq-a-${i}`} id={`faq-q-${i}`} data-faq-toggle>
            <span class="faq-text">{it.q}</span>
            <span class="faq-plus" aria-hidden="true"><i></i><i></i></span>
          </button>
          <div class="faq-a" id={`faq-a-${i}`} role="region" aria-labelledby={`faq-q-${i}`} hidden>
            <div class="faq-a-inner body" set:html={it.a} />
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
)}
<style>
  .faq-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--gap); padding: clamp(40px, 5.5vw, 104px) var(--inset) clamp(24px, 3vw, 56px); border-top: 1px solid var(--line); }
  .faq-side {
    grid-column: 1 / -1;
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gap); align-items: end;
  }
  .faq-side > .h2 { grid-column: 1 / span 7; }
  .faq-note { grid-column: 9 / span 4; margin: 0; }
  .faq-cta { grid-column: 9 / span 4; justify-self: start; }
  .faq-list { grid-column: 1 / -1; border-top: 1px solid var(--line); margin-top: clamp(24px, 3vw, 48px); }
  /* An author display would outrank the UA's [hidden] rule, so it is stated. */
  .faq-list[hidden] { display: none; }
  .faq-cta .arr { transition: transform 0.35s var(--ease); display: inline-block; }
  .faq-cta[aria-expanded="true"] .arr { transform: rotate(90deg); }
  .faq-item { border-bottom: 1px solid var(--line); }
  .faq-q { width: 100%; display: grid; grid-template-columns: 1fr auto; gap: var(--gap); align-items: baseline; text-align: left; padding: clamp(16px, 1.8vw, 28px) 0; transition: color 0.3s; }
  .faq-q:hover { color: var(--gold); }
  .faq-text { font-size: var(--t-lead); line-height: 1.25; letter-spacing: -0.015em; }
  .faq-plus { position: relative; width: 14px; height: 14px; align-self: center; }
  .faq-plus i { position: absolute; inset: 50% auto auto 0; width: 100%; height: 1px; background: currentColor; transition: transform 0.45s var(--ease); }
  .faq-plus i:last-child { transform: rotate(90deg); }
  .faq-q[aria-expanded="true"] .faq-plus i:last-child { transform: rotate(0); }
  .faq-a { overflow: hidden; }
  .faq-a[hidden] { display: none; }
  .faq-a-inner { padding: 0 0 clamp(20px, 2.2vw, 32px); max-width: 62ch; }
  .faq-a-inner :global(a) { color: var(--fg); background: linear-gradient(currentColor, currentColor) no-repeat 0 100% / 100% 1px; }
  .faq-a-inner :global(a:hover) { color: var(--gold); }
  /* Stacked from 1100, matching .sec-title: a four-column note against a
     seven-column heading stops reading as prose below that. */
  @media (max-width: 1100px) {
    .faq-side > .h2, .faq-note, .faq-cta { grid-column: 1 / -1; }
    .faq-note { max-width: 60ch; }
  }
</style>
