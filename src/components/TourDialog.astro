---
// One dialog for the building walk-throughs. The iframe is empty until a tour
// is opened and emptied again on close, so Matterport never loads unprompted.
---
<dialog class="dlg" data-tour-dialog aria-label="3D tour">
  <div class="dlg-bar">
    <span class="label" data-tour-title>3D tour</span>
    <button type="button" class="dlg-close" data-tour-close>Close ✕</button>
  </div>
  <div class="dlg-frame">
    <iframe data-tour-frame title="Matterport 3D tour" allow="fullscreen; xr-spatial-tracking" allowfullscreen loading="lazy"></iframe>
  </div>
</dialog>
