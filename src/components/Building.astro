---
import { Image } from 'astro:assets';
import { photo } from '../lib/photos';
const { site } = Astro.props as { site: any };
const c = site.config;
const f: any[] = c.features ?? [];
const lists: any[] = c.featureLists ?? [];
const tours: any[] = c.amenityTours?.items ?? [];

// Each feature is paired with the photograph of the thing it names, so that on
// a phone the picture and the words can travel as one card instead of the words
// sliding past on their own.
//
// Four of the six are literal: the roof, the gym, a kitchen, a studio. The last
// two have no photograph of their own — nobody has shot the pet wash — so they
// borrow a true picture of the building or the block and are captioned with
// the photograph's own name, so the frame says what it is rather than letting
// the heading above imply something it doesn't show.
const PAIRS: Array<{ slug: string; borrowed?: true }> = [
  { slug: 'exterior-rooftop-terrace' },
  { slug: 'interior-fitness-room' },
  { slug: 'interior-2br-kitchen' },
  { slug: 'interior-studio-main' },
  { slug: 'exterior-paseo', borrowed: true },
  { slug: 'neighborhood-mopop', borrowed: true },
];
const pairs = f.slice(0, 6).map((x, i) => ({ feat: x, borrowed: PAIRS[i].borrowed, pic: photo(PAIRS[i].slug) }));

const club = photo('interior-clubroom');
const lobby = photo('interior-lobby');
const sizes = '(max-width: 720px) 100vw, (max-width: 1024px) 50vw, 60vw';
---
<section class="section building" id="building">
  <div class="sec-title">
    <h2 class="h2" data-reveal>{c.building?.title} <em>{c.building?.titleItalic}</em></h2>
    <p class="body sec-lede" data-reveal>{c.building?.note}</p>
  </div>

  <div class="grid bento">
    {/* display: contents above 640, so the six features and the roof keep their
        bento placement; the swipe strip below that width. */}
    <div class="b-pairs" data-b-pairs>
      {pairs.map((p, i) => (
        <article class="b-pair" aria-label={p.feat.title}>
          {/* Figure first in the DOM so that in the two-column band between
              641 and 1024 the roof still leads the section; the card puts the
              words back on top with `order`. */}
          {i === 0 ? (
            <figure class="cell cell--img b-pfig b-img1" data-reveal>
              <Image src={p.pic.img} alt={p.pic.alt} widths={[640, 960, 1440, 2000]} sizes={sizes} format="webp" quality={76} loading="lazy" />
              <figcaption class="b-cap b-cap--wide label">{p.pic.title}</figcaption>
            </figure>
          ) : (
            <figure class={`cell cell--img b-pfig${p.borrowed ? ' b-pfig--cap' : ''}`}>
              <Image src={p.pic.img} alt={p.pic.alt} widths={[640, 960]} sizes="100vw" format="webp" quality={76} loading="lazy" />
              {p.borrowed && <figcaption class="b-cap label">{p.pic.title}</figcaption>}
            </figure>
          )}
          <div class={`cell b-feat b-f${i + 1}`} data-reveal>
            <h3 class="h3">{p.feat.title}</h3>
            <p class="body">{p.feat.body}</p>
          </div>
        </article>
      ))}
    </div>
    <div class="b-dots" data-b-dots>
      {pairs.map((p, i) => (
        <button type="button" class={`b-dot${i === 0 ? ' is-on' : ''}`} data-b-dot={i} aria-label={p.feat.title} aria-current={i === 0 ? 'true' : 'false'}></button>
      ))}
    </div>
    <figure class="cell cell--img b-img2" data-reveal>
      <Image src={club.img} alt={club.alt} widths={[640, 960, 1440]} sizes={sizes} format="webp" quality={76} />
      <figcaption class="b-cap label">{club.title}</figcaption>
    </figure>
    <figure class="cell cell--img b-img3" data-reveal>
      <Image src={lobby.img} alt={lobby.alt} widths={[640, 960, 1440]} sizes={sizes} format="webp" quality={76} />
      <figcaption class="b-cap label">{lobby.title}</figcaption>
    </figure>
    <div class="cell b-tours" data-reveal>
      <span class="label label--dim">{c.amenityTours?.heading}</span>
      <p class="h3">Three-dimensional tours of the shared spaces.</p>
      <p class="small">{c.amenityTours?.note}</p>
      <div class="b-tour-btns">
        {tours.map((t) => (
          <button type="button" class="btn btn--ghost btn--sm" data-tour={t.url} data-tour-label={t.label}>{t.label} <span class="arr" aria-hidden="true">↗</span></button>
        ))}
      </div>
    </div>
  </div>

  <nav class="lists-jump" aria-label="Amenity lists" data-lists-jump>
    {lists.map((l, i) => (
      <button type="button" class={`ljump${i === 0 ? ' is-active' : ''}`} data-list-jump={i} aria-current={i === 0 ? 'true' : 'false'}>{l.heading}</button>
    ))}
  </nav>
  <div class="grid lists" data-lists>
    {lists.map((l) => (
      <div class="cell list" data-reveal>
        <h3 class="label">{l.heading}</h3>
        <ol class="list-rows">
          {l.items.map((it: string) => (
            <li class="list-row">{it}</li>
          ))}
        </ol>
      </div>
    ))}
  </div>
</section>

<style>
  .bento { grid-auto-rows: minmax(clamp(150px, 14vw, 260px), auto); }
  .bento figure { position: relative; }
  .bento figure :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease); }
  .bento figure:hover :global(img) { transform: scale(1.03); }
  .b-cap { position: absolute; z-index: 1; left: var(--pad); right: var(--pad); bottom: calc(var(--pad) * 0.8); color: var(--fg); text-shadow: 0 1px 12px rgba(0,0,0,0.6); opacity: 0.9; }
  /* The two borrowed photographs are named on the picture, and one of them is
     a bright skyline at midday — a text shadow alone loses that. A short scrim
     off the bottom edge, only where there is something to read. */
  .b-pfig--cap::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 45%;
    background: linear-gradient(180deg, rgba(11, 11, 11, 0) 0%, rgba(11, 11, 11, 0.62) 100%);
    pointer-events: none;
  }
  .b-feat { display: grid; grid-template-rows: auto auto; gap: clamp(16px, 1.8vw, 32px); align-content: start; }
  .b-feat .body { max-width: 34ch; }
  /* The wrappers are transparent to the grid until the strip exists. */
  .b-pairs, .b-pair { display: contents; }
  .b-dots { display: none; }
  .b-img1 { grid-column: 1 / span 7; grid-row: 1 / span 2; min-height: clamp(260px, 36vw, 640px); }
  .b-f1 { grid-column: 8 / span 5; grid-row: 1; }
  .b-f2 { grid-column: 8 / span 5; grid-row: 2; }
  .b-f3 { grid-column: 1 / span 4; grid-row: 3; }
  .b-img2 { grid-column: 5 / span 4; grid-row: 3 / span 2; }
  .b-f4 { grid-column: 9 / span 4; grid-row: 3; }
  .b-f5 { grid-column: 1 / span 4; grid-row: 4; }
  .b-f6 { grid-column: 9 / span 4; grid-row: 4; }
  .b-img3 { grid-column: 1 / span 5; grid-row: 5; min-height: clamp(220px, 24vw, 420px); }
  .b-tours { grid-column: 6 / span 7; grid-row: 5; display: grid; gap: 14px; align-content: start; }
  .b-tours .h3 { max-width: 22ch; font-weight: 400; }
  .b-tour-btns { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
  .lists { margin-top: 1px; }
  .list { grid-column: span 4; }
  /* The chip row only exists for the rail, so it is absent at desktop width
     where all three lists are visible at once and there is nothing to jump to. */
  .lists-jump { display: none; }
  .list-rows { margin-top: clamp(18px, 2vw, 32px); }
  .list-row { padding: 12px 0; border-top: 1px solid var(--line-2); font-size: var(--t-small); color: var(--fg-2); }

  /* Above the strip the bento carries the roof, the clubroom and the lobby,
     and the five other feature photographs are not laid out at all. They are
     lazy, so a hidden one is never fetched either. */
  @media (min-width: 641px) {
    .b-pfig:not(.b-img1) { display: none; }
  }

  @media (max-width: 1024px) {
    .bento { grid-template-columns: repeat(2, 1fr); grid-auto-rows: auto; }
    /* .b-pairs and .b-pair are display:contents here, so their children are
       grid items of .bento but are not matched by `.bento > *`. Reset them
       explicitly or they keep their twelve-column desktop placement. */
    .bento > *, .b-pairs > *, .b-pair > * { grid-column: auto !important; grid-row: auto !important; }
    .bento figure { min-height: 0 !important; aspect-ratio: 4 / 3; }
    .b-img1 { grid-column: 1 / -1 !important; aspect-ratio: 16 / 9; }
    .b-tours { grid-column: 1 / -1 !important; }
    .b-feat { min-height: clamp(180px, 26vw, 260px); }
  }

  /* Phones. Six feature cells stacked full width ran to roughly 1,400px — the
     single biggest block on the page — so they were laid side by side as a
     strip. That fixed the length and introduced a different problem: the words
     slid on their own, past three photographs that stayed put, and a sentence
     travelling away from its picture is a strange thing to watch.

     So the two are one card now. Each of the six is its heading and its blurb
     with the photograph of that amenity underneath, and flipping the strip
     flips both together. The dots below say how many there are and where you
     are, which is the job the old peeking sliver did badly. Nothing above
     640px changes: up there the bento is unaltered. */
  @media (max-width: 640px) {
    .bento { grid-template-columns: 1fr; }

    .b-pairs {
      display: grid;
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 100%;
      gap: 0;
      overflow-x: auto; overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory; scrollbar-width: none;
    }
    .b-pairs::-webkit-scrollbar { display: none; }
    .b-pair {
      display: grid; grid-template-rows: auto 1fr;
      scroll-snap-align: start;
      grid-column: auto !important; grid-row: auto !important;
    }
    /* Words on top, picture under them. */
    .b-feat { order: 1; min-height: 0; gap: 10px; }
    .b-feat .body { max-width: none; }
    .b-feat .h3 { font-size: clamp(1.3rem, 1.1rem + 1.4vw, 1.7rem); }
    .b-pfig { order: 2; display: block; aspect-ratio: 3 / 2; }
    /* The heading directly above already reads "Rooftop terrace". */
    .b-cap--wide { display: none; }
    /* The clubroom and the lobby leave the strip rather than sit under it as
       two more photographs of the same building: the gallery further down
       carries the clubroom terrace, the clubroom kitchen and the vestibule at
       every width, and the Matterport tours walk both rooms. */
    .b-img2, .b-img3 { display: none; }

    /* Not a .cell, so it would otherwise show the grid's own hairline colour
       as a band the width of the page. */
    /* The gap is the pitch, and the pitch has to be the target: the pads
       below are half of it either side, so adjacent dots tile rather than
       overlap. Overlapping pads steal each other's taps. */
    .b-dots { display: flex; gap: 22px; justify-content: center; background: var(--bg); padding: 16px 0 18px; }
    .b-dot {
      width: 7px; height: 7px; padding: 0; border: 0; border-radius: 50%;
      background: var(--line); cursor: pointer;
      transition: background-color 0.3s, transform 0.3s var(--ease);
    }
    /* 7px of dot, 44px of target. */
    /* 7px dot + 11px either side = a 29px target, against a 29px pitch —
       clear of the 24px minimum with room for the active dot's scale. */
    .b-dot::after { content: ''; position: absolute; inset: -18px -11px; }
    .b-dot { position: relative; }
    .b-dot.is-on { background: var(--gold); transform: scale(1.25); }
    .b-dot:focus-visible { outline: 2px solid var(--gold); outline-offset: 6px; }

    .list-rows { margin-top: 14px; }
    .list-row { padding: 10px 0; }
  }

  /* The three amenity lists, everywhere below the three-up desktop layout.

     Two things were wrong. The rail never actually railed: .lists carries
     .grid, whose twelve-track template stayed in force, so grid-auto-flow:
     column dropped the lists into 1/12-width tracks — 46px wide at 560px,
     which is why the section stayed tall instead of turning into a strip.
     grid-template-columns has to be cleared for grid-auto-columns to govern.

     And it only applied below 640. Between 641 and 1024 the lists were three
     full-width blocks stacked: about 1,200px, more than a tenth of the page,
     against 570px once they go three-up at 1100. That band is what Leary
     screenshotted. The rail now covers the whole range below the three-up
     layout, and the cards cap at 420px so they do not become unreadably wide
     at the top of it. */
  @media (max-width: 1024px) {
    /* Cards are the full width of the rail rather than 82% of it. The peek was
       meant to advertise that the strip scrolls, but what it actually showed
       was the next list's sentences sliced down the middle — "In-unit was",
       "Stainless st / range and" — which reads as a broken layout, not as an
       invitation. The chip row above does the advertising instead, and says
       what is in each card while it is at it. Mandatory snap so a card is
       never left straddling the edge. */
    .lists {
      display: grid;
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 100%;
      gap: 0; overflow-x: auto; overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory; scrollbar-width: none;
    }
    .lists::-webkit-scrollbar { display: none; }
    .list { grid-column: auto; scroll-snap-align: start; }
    /* The chip above the rail already names the card, so the card's own
       heading would print it twice. Hidden from the eye, kept for the
       accessibility tree so each list still has a heading of its own. */
    .list > .label {
      position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
      overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
    }
    .list-rows { margin-top: 0; }

    .lists-jump {
      display: flex; gap: 22px;
      padding: clamp(20px, 3vw, 30px) var(--inset) 0;
      overflow-x: auto; scrollbar-width: none;
      border-top: 1px solid var(--line);
    }
    .lists-jump::-webkit-scrollbar { display: none; }
    .ljump {
      position: relative; flex: 0 0 auto;
      padding: 10px 0; background: none; border: 0; cursor: pointer;
      font-family: inherit; font-size: var(--t-label);
      text-transform: uppercase; letter-spacing: 0.06em;
      color: var(--fg-3); transition: color 0.3s;
    }
    .ljump::after {
      content: ''; position: absolute; left: 0; right: 0; bottom: 2px; height: 2px;
      background: var(--gold); transform: scaleX(0); transform-origin: left;
      transition: transform 0.45s var(--ease);
    }
    .ljump.is-active { color: var(--fg); }
    .ljump.is-active::after { transform: scaleX(1); }
    .ljump:focus-visible { outline: 2px solid var(--gold); outline-offset: 4px; }
    @media (pointer: coarse) { .ljump { padding: 13px 0; } }
  }
</style>
