---
// Persistent mobile call-to-action bar.
//
// The highest-leverage lead-capture element on mobile: a thumb-reachable
// Call / Schedule-a-tour pair that never scrolls away. Mobile-only by design —
// on desktop the header CTA and the floating contact button already cover this.
//
// Contact details come from site config, so every property inherits it.
// Clicks are picked up by the existing delegated analytics listeners
// (tel: links fire `phone_click`); the tour button jumps to the tour section.
import { formatPhone } from '../lib/site';

const { site } = Astro.props as { site: { config: any } };
const c = site.config;
const phoneHref = c.contact?.phoneHref;
const phoneLabel = formatPhone(c.contact?.phone);
---
{phoneHref && (
  <div class="sticky-cta" id="sticky-cta" aria-label="Contact actions">
    <a href={phoneHref} class="sticky-cta-btn sticky-cta-call" aria-label={`Call ${phoneLabel}`}>
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.35 1.9.66 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.31 1.85.53 2.81.66A2 2 0 0 1 22 16.92z"/>
      </svg>
      <span>Call</span>
    </a>
    <a href="#tour" class="sticky-cta-btn sticky-cta-tour">
      Schedule a tour
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
      </svg>
    </a>
  </div>
)}
