---
// Arrival film.
//
// Stakeholder direction was vibrantcities.com — a full-screen film on arrival.
// Overlaying the headline on it failed: the film carries its own burned-in
// captions, and "Iconically, Seattle." fought them for the same pixels. So the
// film gets the screen to itself, uninterrupted, and when it ends it fades out
// to the split hero underneath. Nothing is layered over the footage at any
// point, which is the whole reason this exists.
//
// It sits at the very top of <body> with its decision script inline directly
// after it, so it covers the viewport in the same paint as the page rather
// than dropping over a hero the visitor has already started reading.
//
// Shown once per tab (sessionStorage), skippable, and abandoned on any hint
// that the visitor would rather get on with it. `?intro=on` replays it and
// `?intro=off` suppresses it, which is how it gets reviewed and screenshotted.
const { site } = Astro.props as { site: { config: any } };
const v = site.config.hero?.video ?? {};
const intro = v.arrival ?? {};
// Source list, best format first — VP9/WebM is a third the size of the H.264
// cut, and Safari falls through to the MP4.
const sources: { src: string; type?: string }[] = Array.isArray(intro.sources)
  ? intro.sources
  : (Array.isArray(v.full) ? v.full : (v.full ? [{ src: v.full, type: 'video/mp4' }] : []));
// A site with video switched off entirely shouldn't get an arrival film either.
const enabled = intro.enabled === true && sources.length > 0 && (v.mode ?? 'off') !== 'off';

// A 16:9 frame on a portrait phone is a band a quarter of the screen tall, and
// the film cannot be cropped to fill — its captions run to both edges. So on
// phones the letterbox is composed rather than left empty: wordmark above the
// band, film, skip control below. Same wordmark as the nav.
const siteName: string = site.config.name ?? '';
const lastSpace = siteName.lastIndexOf(' ');
const markLead = site.config.wordmark?.lead ?? (lastSpace === -1 ? siteName : siteName.slice(0, lastSpace));
const markEmph = site.config.wordmark?.emph ?? (lastSpace === -1 ? '' : siteName.slice(lastSpace + 1));
---
{enabled && (
  <>
    <div class="arrival-film" id="arrival-film" hidden style={v.poster ? `--film-backdrop: url(${v.poster})` : undefined}>
      {/* The space is explicit: Astro collapses the whitespace between two
          expressions across a line break, which ran this together as
          "NiwaApartments". */}
      <p class="arrival-film-mark" aria-hidden="true">{markLead}{' '}<em>{markEmph}</em></p>
      <video
        class="arrival-film-video"
        muted
        playsinline
        preload="auto"
        poster={v.poster}
        aria-hidden="true"
        tabindex="-1"
      >
        {sources.map((s) => <source src={s.src} type={s.type} />)}
      </video>
      <button type="button" class="arrival-film-skip">
        <span>{intro.skipLabel || "Skip intro"}</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
        </svg>
      </button>
    </div>
    <script is:inline>
      (function () {
        var el = document.getElementById('arrival-film');
        if (!el) return;
        var root = document.documentElement;
        var video = el.querySelector('.arrival-film-video');
        var params = new URLSearchParams(location.search);
        var force = params.get('intro');

        // Reasons not to run it. A multi-megabyte autoplay is hostile on a
        // metered phone, motion sensitivity is a real accessibility need, and a
        // film that reappears on every navigation stops being a welcome and
        // becomes an obstacle between a renter and the floor plans.
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var conn = navigator.connection || {};
        var thin = !!conn.saveData || /^(slow-)?2g$/.test(conn.effectiveType || '');
        var seen = false;
        try { seen = sessionStorage.getItem('niwa:arrival-film') === '1'; } catch (e) {}
        if (force === 'off' || (force !== 'on' && (reduce || thin || seen))) {
          el.remove();
          return;
        }
        try { sessionStorage.setItem('niwa:arrival-film', '1'); } catch (e) {}

        el.hidden = false;
        root.classList.add('arrival-film-open');

        var done = false;
        var startWatchdog;
        var runWatchdog;

        function finish() {
          if (done) return;
          done = true;
          clearTimeout(startWatchdog);
          clearTimeout(runWatchdog);
          window.removeEventListener('wheel', onIntent);
          window.removeEventListener('touchmove', onIntent);
          window.removeEventListener('keydown', onKey);
          // Hand over first, fade second. The hero's loop is told to play before
          // anything starts moving, so the crossfade lands on live footage —
          // dispatching this alongside the fade meant the film dissolved into a
          // still photograph and the panel popped into video a beat later.
          document.dispatchEvent(new CustomEvent('niwa:arrival-film-done'));
          root.classList.remove('arrival-film-open');
          // Two frames: one for the browser to apply the class-free state, one
          // for it to notice the change. Setting the class in the same tick as
          // the layout above can be coalesced into the first paint, and the
          // transition is skipped entirely — it snaps instead of fading.
          requestAnimationFrame(function () {
            requestAnimationFrame(function () { el.classList.add('is-done'); });
          });
          // The film plays the whole way out. Pausing on the way in froze the
          // last frame and then dissolved a still — which is the cut this
          // transition exists to avoid. It stops when the element goes.
          setTimeout(function () {
            try { video.pause(); } catch (e) {}
            el.remove();
          }, 1400);
        }

        function onIntent() { finish(); }
        function onKey(e) {
          if (e.key === 'Escape' || e.key === ' ' || e.key === 'Enter' ||
              e.key === 'PageDown' || e.key === 'ArrowDown') finish();
        }

        var skip = el.querySelector('.arrival-film-skip');
        skip.addEventListener('click', finish);

        // The nav sits over the film and stays live. Clicking it clears the film
        // and then lets the link do exactly what it always does — a menu button
        // that only dismisses a video and drops you back at the top reads as
        // broken the first time anyone uses it.
        //
        // Not preventDefault and not a manual scroll: `finish()` releases the
        // scroll lock synchronously, so the browser's own hash navigation lands
        // correctly on the same click.
        // Delegated on the document, not on `.nav`. This script runs inline at
        // the top of <body>, so the nav has not been parsed yet and
        // querySelector('.nav') returns null — the listener silently never
        // attached, and clicking the menu scrolled the page underneath a film
        // that stayed put. Caught by hit-testing the click, not by reading it.
        document.addEventListener('click', function (e) {
          var t = e.target;
          if (t && t.closest && t.closest('.nav a, .nav button')) finish();
        }, true);
        // The only thing on screen worth reaching, so put the caret on it — a
        // keyboard visitor shouldn't have to guess their way out of a film.
        try { skip.focus({ preventScroll: true }); } catch (e) { skip.focus(); }
        video.addEventListener('ended', finish);
        video.addEventListener('error', finish);
        // `error` on the <video> doesn't fire for a failed <source>; the element
        // only gives up once every source has been tried, and reports that on the
        // last child. Watching both covers a 404 and a missing codec.
        video.lastElementChild.addEventListener('error', finish);
        // Autoplay can still be refused, and the fetch can stall. Either way the
        // visitor must not be held on the poster frame indefinitely, so give it
        // five seconds from the moment it is asked to play, and hand over to the
        // page if nothing has started by then.
        video.addEventListener('playing', function () {
          clearTimeout(startWatchdog);
          // And a second cap once the length is known, in case playback dies
          // partway and `ended` never arrives.
          var d = isFinite(video.duration) ? video.duration : 40;
          runWatchdog = setTimeout(finish, (d + 8) * 1000);
        }, { once: true });

        function start() {
          // Scrolling is the clearest "I'm done watching" there is. The page is
          // locked underneath, so these only ever mean dismiss — but they are
          // only bound now, because while the door is still folding the same
          // gestures mean "open it", and one flick of a wheel would otherwise
          // open the screen and throw away the film behind it in one go.
          window.addEventListener('wheel', onIntent, { passive: true });
          window.addEventListener('touchmove', onIntent, { passive: true });
          window.addEventListener('keydown', onKey);
          startWatchdog = setTimeout(finish, 5000);
          video.play().catch(finish);
        }
        start();
      })();
    </script>
  </>
)}
