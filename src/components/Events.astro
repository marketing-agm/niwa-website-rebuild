---
import { getEvents, byDay, type SiteEvent } from '../lib/events';
const { site } = Astro.props as { site: any };
const c = site.config;
const feed = getEvents();
const { events, categories, window: win } = feed;

// One pin per venue, not per event: a season at one hall would otherwise stack
// a dozen dots on the same twenty pixels and say nothing.
type Pin = { key: string; name: string; east: number; north: number; miles: number; ids: string[] };
const pins: Pin[] = [];
for (const e of events) {
  if (e.east == null || e.north == null) continue;
  const found = pins.find((p) => p.key === e.venue.name.toLowerCase());
  if (found) { found.ids.push(e.id); continue; }
  pins.push({ key: e.venue.name.toLowerCase(), name: e.venue.name, east: e.east, north: e.north, miles: e.miles ?? 0, ids: [e.id] });
}

// The map fits the farthest pin, rounded up to a half mile, and never claims a
// wider view than the feed was gathered over.
// A square field, because the thing drawn in it is a circle. It used to be
// 1000 × 620, which wasted a third of the width on desktop and, on a phone,
// let the plot shrink to fit the height while the sides sat empty.
const W = 620, H = 620, CX = W / 2, CY = H / 2, PAD = 46;
const RMAX = H / 2 - PAD;
const fitMiles = Math.min(win.radiusMiles, Math.max(0.5, Math.ceil(pins.reduce((m, p) => Math.max(m, p.miles), 0.5) * 2) / 2));

// Radius goes as the square root of the distance, not the distance. Straight
// linear scaling is what a paper map does, and on this particular block it is
// useless: five of Seattle Center's halls are inside a quarter mile of the
// front door, so at a two-mile fit they land on top of each other in the
// middle while the outer four fifths of the circle sits empty.
//
// The square root spreads the near ones out and compresses the far ones, and
// the rings — drawn on the same curve and labelled with their true distance —
// are what keep it honest. Bearing is untouched: north is north, and a venue
// due south of the building is drawn due south of it. If it errs, it errs by
// making things look farther away than they are, which is the safe direction
// for a page whose whole argument is that everything is close.
const rPx = (m: number) => RMAX * Math.sqrt(Math.max(0, Math.min(1, m / fitMiles)));
const RINGS = [0.25, 0.5, 1, 2, 3, 5].filter((r) => r <= fitMiles + 0.001);
const at = (p: { east: number; north: number }) => {
  const d = Math.hypot(p.east, p.north);
  if (d < 1e-9) return { x: CX, y: CY };
  const r = rPx(d);
  return { x: CX + (p.east / d) * r, y: CY - (p.north / d) * r };
};
const ringLabel = (r: number) => (r < 1 ? `${r === 0.25 ? '¼' : '½'} mi` : `${r} mi`);

// Venues that land on top of each other become one pin.
//
// Clustered by where they are drawn, not by where they are: the square-root
// scale means two venues the same distance apart can sit very differently on
// the plate, and what matters here is only whether their dots collide. Eleven
// of the fifteen fall inside a mile to the south-east — the whole of downtown
// from this doorstep — and on a phone that was a knot nobody could tap apart.
//
// Agglomerative and run to a fixed point rather than in one pass, so the
// result does not depend on the order the venues arrive in. Fifteen pins, so
// the cost of doing it properly is nothing.
// Also the floor on how far apart two pins can end up, which is what lets the
// invisible tap circles below be sized without overlapping: at 44 units apart
// a 21-unit hit radius can never reach into its neighbour. Two pins did reach,
// at first, and the covered one could not be tapped at all.
const COLLIDE = 44; // viewBox units
type Cluster = { x: number; y: number; venues: Pin[]; ids: string[]; miles: number };

let clusters: Cluster[] = pins.map((p) => {
  const { x, y } = at(p);
  return { x, y, venues: [p], ids: [...p.ids], miles: p.miles };
});

for (let guard = 0; guard < 200; guard++) {
  let best: [number, number, number] | null = null;
  for (let i = 0; i < clusters.length; i++) {
    for (let j = i + 1; j < clusters.length; j++) {
      const d = Math.hypot(clusters[i].x - clusters[j].x, clusters[i].y - clusters[j].y);
      if (d < COLLIDE && (!best || d < best[2])) best = [i, j, d];
    }
  }
  if (!best) break;
  const [i, j] = best;
  const a = clusters[i], b = clusters[j];
  // Weighted by how much is on at each, so the dot sits nearer the busier room.
  const wa = a.ids.length, wb = b.ids.length, wt = wa + wb;
  clusters[i] = {
    x: (a.x * wa + b.x * wb) / wt,
    y: (a.y * wa + b.y * wb) / wt,
    venues: [...a.venues, ...b.venues].sort((m, n) => n.ids.length - m.ids.length),
    ids: [...a.ids, ...b.ids],
    miles: Math.min(a.miles, b.miles),
  };
  clusters.splice(j, 1);
}
clusters.sort((a, b) => a.ids.length - b.ids.length); // busiest drawn last, on top

/** Up to two venue names, then a count. One line each. */
const clusterLines = (cl: Cluster): string[] => {
  if (cl.venues.length === 1) return [cl.venues[0].name];
  const shown = cl.venues.slice(0, 2).map((v) => v.name);
  const rest = cl.venues.length - shown.length;
  return rest > 0 ? [...shown, `and ${rest} more`] : shown;
};
const clusterLabel = (cl: Cluster) => {
  const n = cl.ids.length;
  const where = cl.venues.length === 1 ? cl.venues[0].name : `${cl.venues.length} venues`;
  return `${n} event${n === 1 ? '' : 's'} at ${where}, ${cl.miles.toFixed(1)} miles away`;
};

const groups = byDay(events);
const updated = feed.updated
  ? new Intl.DateTimeFormat('en-US', { timeZone: 'America/Los_Angeles', month: 'long', day: 'numeric' }).format(new Date(feed.updated))
  : null;
// "A and B", "A, B and C" — a credit line, not a list of vendors.
const credit = feed.sources.length
  ? feed.sources.length === 1
    ? feed.sources[0]
    : `${feed.sources.slice(0, -1).join(', ')} and ${feed.sources[feed.sources.length - 1]}`
  : null;
const miles = (e: SiteEvent) => (e.miles == null ? '' : e.miles < 0.15 ? 'next door' : `${e.miles.toFixed(1)} mi`);
---
<section class="section ev" id="events" data-events>
  <div class="ev-head">
    <span class="label label--dim">Queen Anne &amp; Seattle Center</span>
    <h1 class="h1 ev-title" data-reveal>What's on, <em>close to home.</em></h1>
    <p class="lead ev-lede" data-reveal>
      {events.length > 0
        ? `The neighbourhood's own calendar and everything on sale within ${win.radiusMiles} miles of the front door, over the next ${win.days} days. Climate Pledge Arena is at the end of the block; most of the rest is a walk.`
        : `This page lists what's on within ${win.radiusMiles} miles of the front door. The feed refreshes every Monday — nothing is listed right now.`}
    </p>
    {updated && <p class="mono ev-updated">Updated {updated}{credit ? ` · ${credit}` : ''}</p>}
  </div>

  {events.length > 0 && (
    <>
      <div class="ev-map-wrap">
        <svg class="ev-map" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Map of ${pins.length} venue${pins.length === 1 ? '' : 's'} within ${fitMiles} miles of ${c.name}`} data-ev-map>
          <g class="ev-rings" aria-hidden="true">
            {/* Each ring is drawn twice, the second a hair inside it and
                fainter — a rake leaves a furrow, not a line. */}
            {RINGS.map((r, i) => <circle style={`--i:${i}`} cx={CX} cy={CY} r={rPx(r)} />)}
            {RINGS.map((r, i) => <circle class="ev-ring-2" style={`--i:${i}`} cx={CX} cy={CY} r={Math.max(0, rPx(r) - 3.5)} />)}
            {/* West of the axis, not east: the pins fall where the city is,
                which from Queen Anne is east and south, and the labels were
                landing on top of them. */}
            {RINGS.map((r) => <text class="ev-ring-t ev-ring-l" x={CX - 9} y={CY - rPx(r) - 8}>{ringLabel(r)}</text>)}
            <line x1={CX - RMAX} y1={CY} x2={CX + RMAX} y2={CY} />
            <line x1={CX} y1={CY - RMAX} x2={CX} y2={CY + RMAX} />
            {/* East of the axis, now that the ring labels have the west side. */}
            <text class="ev-ring-t ev-n" x={CX + 10} y={CY - RMAX - 8}>N</text>
          </g>
          {/* Ripples in a layer of their own, under the pins and clipped to the
              plate, so one can cross the whole raked field without escaping
              it. Inside a pin they could only ever be a halo: a clip path
              resolves in the user space of the element that references it, and
              inside a translated group that space moves with the pin. */}
          <defs>
            <clipPath id="ev-plate"><circle cx={CX} cy={CY} r={RMAX} /></clipPath>
          </defs>
          <g class="ev-ripples" clip-path="url(#ev-plate)" aria-hidden="true">
            {clusters.map((cl, ci) => (
              <g class="ev-fx" data-ev-fx={`c${ci}`} transform={`translate(${cl.x} ${cl.y})`}>
                <circle class="ev-ripple" r="12" />
                <circle class="ev-ripple ev-ripple--2" r="12" />
                <circle class="ev-ripple ev-ripple--3" r="12" />
              </g>
            ))}
          </g>
          {clusters.map((cl, ci) => {
            const n = cl.ids.length;
            const r = n > 1 ? Math.min(15, Math.max(9, 6 + n)) : 6;
            return (
              <g class="ev-pin" data-ev-pin={`c${ci}`} data-ev-pin-ids={cl.ids.join(' ')}
                 data-ev-pin-name={cl.venues.length === 1 ? cl.venues[0].name : `${cl.venues[0].name} + ${cl.venues.length - 1} more`}
                 transform={`translate(${cl.x} ${cl.y})`} tabindex="0" role="button" aria-pressed="false" aria-label={clusterLabel(cl)}>
                {/* 21 units: half of COLLIDE, so hit areas tile rather than
                    steal. About 24px across on a phone, which is the smallest
                    target WCAG asks for — and the cards below carry everything
                    a pin does, for anyone who would rather not aim. */}
                <circle class="ev-pin-hit" r="21" />
                {/* Two rings that spread and fade, the way a stone set down in
                    a raked garden sends one out through the sand. */}
                <circle class="ev-pin-dot" r={r} />
                {n > 1 && <text class="ev-pin-n" y="4">{n}</text>}
              </g>
            );
          })}
          {/* Labels in their own layer, drawn after every pin, so a label is
              never underneath a neighbouring dot. They used to sit inside the
              pin and get hoisted to the end of the group on hover — which
              worked, and broke the click: moving a node out from under the
              cursor means no click ever lands. Touch has no hover, so it only
              ever failed with a mouse.

              Below the dot when the pin is south of the building and above
              when it is north, so the label reads outward, away from the
              crowded middle. */}
          <g class="ev-labels" aria-hidden="true">
            {clusters.map((cl, ci) => {
              const n = cl.ids.length;
              const r = n > 1 ? Math.min(15, Math.max(9, 6 + n)) : 6;
              const lines = clusterLines(cl);
              const below = cl.y > CY;
              return (
                <text class="ev-pin-label" data-ev-label={`c${ci}`}
                      transform={`translate(${cl.x} ${cl.y})`} y={below ? r + 26 : -r - 10}>
                  {lines.map((line, i) => (
                    <tspan x="0" dy={i === 0 ? (below ? 0 : -(lines.length - 1) * 17) : 17}>{line}</tspan>
                  ))}
                </text>
              );
            })}
          </g>
          <g class="ev-home" transform={`translate(${CX} ${CY})`}>
            <circle class="ev-home-ring" r="13" />
            <circle class="ev-home-dot" r="5" />
            <text class="ev-home-t" y="30">{c.name.replace(' Apartments', '')}</text>
          </g>
        </svg>
        <p class="ev-map-note small">
          Distances are straight-line from {c.address.streetAddress}. Tap a pin to jump to its events{pins.length > clusters.length ? '; venues that fall on the same spot share one' : ''}.
          {feed.unpinned > 0 && ` ${feed.unpinned} ${feed.unpinned === 1 ? 'listing gives' : 'listings give'} no location, so ${feed.unpinned === 1 ? 'it is' : 'they are'} below but not on the map.`}
        </p>
      </div>

      <div class="ev-bar">
        <div class="ev-filters" role="group" aria-label="Filter by category">
          {/* Filled in and revealed when a pin is tapped. Rendered here rather
              than created in script so that it carries this component's scoped
              styles — built in JS it came out as unstyled text. */}
          <button type="button" class="ev-chip ev-chip--venue" data-ev-venue-chip hidden>
            <span data-ev-venue-name></span>
            <span class="ev-chip-n" data-ev-venue-n></span>
            <span class="ev-chip-x" aria-hidden="true">✕</span>
          </button>
          <button type="button" class="ev-chip is-on" data-ev-cat="all" aria-pressed="true">Everything <span class="ev-chip-n">{events.length}</span></button>
          {categories.map((cat) => (
            <button type="button" class="ev-chip" data-ev-cat={cat} aria-pressed="false">{cat} <span class="ev-chip-n">{events.filter((e) => e.category === cat).length}</span></button>
          ))}
        </div>
        <div class="ev-views" role="group" aria-label="View">
          <button type="button" class="ev-view is-on" data-ev-view="grid" aria-pressed="true">Grid</button>
          <button type="button" class="ev-view" data-ev-view="list" aria-pressed="false">List</button>
        </div>
      </div>

      <p class="ev-empty mono" data-ev-empty hidden>Nothing in that category this month.</p>

      {/* One set of records, two shapes. The grid is for browsing, the list is
          for a date you already have in mind — so the list keeps its day
          headings and the grid does not. */}
      <div class="ev-grid" data-ev-grid>
        {events.map((e) => (
          <article class="ev-card" data-ev-item={e.id} data-ev-venue={e.venue.name.toLowerCase()} data-ev-cat-of={e.category ?? ''}>
            <div class="ev-when">
              <span class="ev-dow">{e.shortDay}</span>
              <span class="ev-dnum">{e.dayNum}</span>
              <span class="ev-mon">{e.monthAbbr}</span>
            </div>
            <h2 class="h3 ev-name">
              {e.url ? <a class="link" href={e.url} target="_blank" rel="noopener nofollow">{e.title}</a> : e.title}
            </h2>
            <p class="ev-meta mono">
              {e.timeLabel && <span>{e.timeLabel}</span>}
              <span class="ev-venue">{e.venue.name}</span>
            </p>
            <p class="ev-foot mono">
              {e.category && <span class="ev-tag">{e.category}</span>}
              {e.miles != null && <span class="ev-dist">{miles(e)}{e.walkMinutes && e.miles < 1.6 ? ` · ${e.walkMinutes} min walk` : ''}</span>}
            </p>
          </article>
        ))}
      </div>

      <div class="ev-list" data-ev-list hidden>
        {groups.map((g) => (
          <div class="ev-day" data-ev-day={g.day}>
            <h2 class="label ev-day-h">{g.label}</h2>
            {g.events.map((e) => (
              <article class="ev-row" data-ev-item={e.id} data-ev-venue={e.venue.name.toLowerCase()} data-ev-cat-of={e.category ?? ''}>
                <span class="ev-row-t mono">{e.timeLabel || 'All day'}</span>
                <span class="ev-row-n">{e.url ? <a class="link" href={e.url} target="_blank" rel="noopener nofollow">{e.title}</a> : e.title}</span>
                <span class="ev-row-v mono">{e.venue.name}</span>
                <span class="ev-row-c mono">{e.category}</span>
                <span class="ev-row-d mono">{miles(e)}</span>
              </article>
            ))}
          </div>
        ))}
      </div>
    </>
  )}

  {events.length === 0 && (
    <div class="ev-none">
      <p class="h3">The feed is empty.</p>
      <p class="body">It refreshes automatically every Monday morning, from Visit Seattle's Queen Anne listings and from Ticketmaster. If it stays empty, one of the two needs looking at.</p>
    </div>
  )}
</section>

<style>
  .ev { padding-top: clamp(28px, 4vw, 64px); }
  .ev-head { padding: 0 var(--inset) clamp(28px, 3.4vw, 52px); display: grid; gap: 14px; }
  .ev-title { max-width: 16ch; }
  .ev-title em { font-style: italic; font-weight: 400; }
  .ev-lede { max-width: 52ch; color: var(--fg-2); }
  .ev-updated { color: var(--fg-3); }

  /* ---- the map ---- */
  /* Square, and centred rather than stretched: a circle in a wide box is
     mostly empty corner. On a phone it takes the full width it is given. */
  .ev-map-wrap { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: clamp(16px, 2vw, 30px) var(--inset) clamp(12px, 1.4vw, 20px); }
  .ev-map { display: block; width: 100%; max-width: 560px; margin: 0 auto; height: auto; overflow: visible; }
  .ev-rings circle {
    fill: none; stroke: var(--line);
    /* fill-box on a circle is its own bounding box, so the origin lands on
       cx,cy for every ring without repeating the numbers here. */
    transform-box: fill-box; transform-origin: center;
  }
  .ev-rings .ev-ring-2 { stroke: var(--line-2); }
  .ev-rings line { stroke: var(--line-2); }
  .ev-ring-t { fill: var(--fg-3); font-family: var(--sans); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; }
  .ev-ring-l { text-anchor: end; }
  .ev-n { text-anchor: start; fill: var(--fg-3); }
  .ev-map-note { color: var(--fg-3); margin: 12px auto 0; max-width: 560px; text-align: center; }

  .ev-pin { cursor: pointer; }
  .ev-pin-hit { fill: transparent; }
  .ev-pin-dot { fill: var(--gold); transition: r 0.25s var(--ease), fill 0.25s; }

  /* Niwa means garden, and the map is already a set of concentric rings raked
     round the building. So a pin you touch sends one out: two rings spreading
     and thinning, the way a stone set down in a karesansui garden throws a
     line through the sand. They exist only while the pin is live, and reduced
     motion gets none of it. */
  .ev-ripple {
    fill: none; stroke: var(--gold); stroke-width: 1.2;
    /* The stroke would otherwise be multiplied by the scale below and arrive
       at the rim forty times too thick. */
    vector-effect: non-scaling-stroke;
    transform-box: fill-box; transform-origin: center;
    opacity: 0; pointer-events: none;
  }
  /* 12 units out to about 500 — from the dot to the far side of the plate, so
     it is a ripple crossing water rather than a ring around a pin. */
  .ev-fx.is-lit .ev-ripple { animation: ev-rake 5s cubic-bezier(0.12, 0.5, 0.25, 1) infinite; }
  .ev-ripple--2 { animation-delay: 1.66s !important; }
  .ev-ripple--3 { animation-delay: 3.33s !important; }
  @keyframes ev-rake {
    0%   { opacity: 0;    transform: scale(1); }
    3%   { opacity: 0.32; }
    100% { opacity: 0;    transform: scale(42); }
  }

  /* And the whole figure answers. Hovering the map sends a swell out through
     the raked rings: each one swells, brightens and settles a beat after the
     one inside it, so a single wave travels from the building to the rim.
     The rings are the surface — the pin ripple is what lands on it. */
  @media (hover: hover) {
    .ev-map:hover .ev-rings circle {
      animation: ev-sand 4.2s ease-in-out infinite;
      animation-delay: calc(var(--i, 0) * 0.26s);
    }
  }
  .ev-map.is-live .ev-rings circle {
    animation: ev-sand 4.2s ease-in-out infinite;
    animation-delay: calc(var(--i, 0) * 0.26s);
  }
  /* The swell is 1.2% — about three units at the rim and less on every ring
     inside it. Water, not a distance error: the outermost ring reads three
     miles and moves by a fiftieth of one. The undershoot at 70% is the
     settle; without it the ring breathes instead of rippling. The bright peak
     is derived from the palette rather than typed in, and lands a little
     under twice the rings' resting weight — enough that the eye catches
     something crossing, not enough to look like the map is signalling. */
  @keyframes ev-sand {
    0%   { transform: scale(1);     stroke: var(--line); }
    35%  { transform: scale(1.012); stroke: color-mix(in srgb, var(--fg) 22%, transparent); }
    70%  { transform: scale(0.996); }
    100% { transform: scale(1);     stroke: var(--line); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ev-fx.is-lit .ev-ripple,
    .ev-map:hover .ev-rings circle, .ev-map.is-live .ev-rings circle { animation: none; }
  }
  .ev-pin-n { fill: var(--ink); text-anchor: middle; font-family: var(--sans); font-size: 12px; font-weight: 600; pointer-events: none; }
  .ev-pin-label {
    fill: var(--fg); text-anchor: middle; font-family: var(--sans); font-size: 14px;
    paint-order: stroke; stroke: var(--bg); stroke-width: 5px; stroke-linejoin: round;
    opacity: 0; transition: opacity 0.25s; pointer-events: none;
  }
  .ev-pin-label.is-lit { opacity: 1; }
  .ev-pin.is-lit .ev-pin-dot { fill: var(--fg); }
  /* Chosen, not merely pointed at: the dot inverts and keeps its name up. */
  .ev-pin.is-on .ev-pin-dot { fill: var(--fg); stroke: var(--gold); stroke-width: 3; }
  .ev-pin.is-on .ev-pin-n { fill: var(--ink); }
  /* Quiet, not gone: the venue is still there, it just has nothing on under
     the current filter. At --line it went so dark the map stopped reading as
     a map at all. */
  .ev-pin.is-out .ev-pin-dot { fill: var(--fg-3); }
  .ev-pin.is-out .ev-pin-n { fill: var(--bg); }
  /* Chrome draws a focus rectangle on a tabindex'd <g> after a mouse click.
     The keyboard ring below is the one worth having. */
  .ev-pin:focus { outline: none; }
  .ev-pin:focus-visible { outline: none; }
  .ev-pin:focus-visible .ev-pin-dot { stroke: var(--fg); stroke-width: 3; }
  @media (hover: hover) { .ev-pin:hover .ev-pin-dot { fill: var(--fg); } }

  .ev-home-ring { fill: none; stroke: var(--fg-3); stroke-dasharray: 2 4; }
  .ev-home-dot { fill: var(--fg); }
  .ev-home-t { fill: var(--fg); text-anchor: middle; font-family: var(--sans); font-size: 14px; letter-spacing: 0.06em; text-transform: uppercase; paint-order: stroke; stroke: var(--bg); stroke-width: 5px; stroke-linejoin: round; }

  /* ---- controls ---- */
  /* Tapping a pin scrolls here, and the nav is fixed — without this the chip
     that says what was just filtered lands underneath it. */
  .ev-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding: clamp(18px, 2vw, 28px) var(--inset); border-bottom: 1px solid var(--line); scroll-margin-top: calc(var(--nav-h, 64px) + 10px); }
  .ev-filters { display: flex; flex-wrap: wrap; gap: 8px; }
  .ev-chip, .ev-view {
    font-family: inherit; font-size: var(--t-label); letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--fg-3); background: none; border: 1px solid var(--line); border-radius: 999px;
    padding: 9px 15px; cursor: pointer; transition: color 0.3s, border-color 0.3s, background-color 0.3s;
  }
  .ev-chip-n { opacity: 0.55; margin-left: 0.35em; font-variant-numeric: tabular-nums; }
  .ev-chip.is-on { background: var(--gold); border-color: var(--gold); color: var(--ink); }
  /* Put there by tapping a pin. It carries its own dismiss, because a filter
     you cannot see the end of is a filter people get stuck in. */
