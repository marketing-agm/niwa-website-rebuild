---
// Analytics layer — wired once in the template, inherited by every site.
// Per-site IDs come from site.config.json -> analytics.{posthog,clarity}.
// No IDs set => nothing loads (safe no-op), so the live site is unaffected
// until you drop real keys in.
const { site } = Astro.props as { site: { id: string; config: any } };
const ph = site.config.analytics?.posthog ?? {};
const clarity = site.config.analytics?.clarity ?? {};
const google = site.config.analytics?.google ?? {};
const siteId = site.id;
const propertyName = site.config.name;

// Google tag: GA4 and/or Google Ads. Either can be set alone. The tag only
// loads when at least one ID is present, so an un-configured site stays clean.
const ga4Id = google.ga4Id || '';
const adsId = google.adsId || '';
const googleTagId = ga4Id || adsId;
// event name -> Google Ads conversion label (the part after the slash in
// "AW-123456789/AbC-D_efGh"). Only labelled events are sent to Ads.
const conversionLabels = google.conversionLabels ?? {};
// event name -> value passed to Ads/GA4. Relative worth of each action, used
// by Smart Bidding to prefer leads over low-intent micro-conversions.
const conversionValues = google.conversionValues ?? {};
---

{ph.key && (
  <script is:inline define:vars={{ phKey: ph.key, phHost: ph.host || 'https://us.i.posthog.com', siteId, propertyName }}>
