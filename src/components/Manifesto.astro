---
const { site } = Astro.props as { site: any };
const c = site.config;
const ws = c.walkScores ?? {};
// Walk Score's own descriptors for these bands.
const scores = [
  { k: 'Walk Score', v: ws.walk, d: 'Daily errands do not require a car.' },
  { k: 'Bike Score', v: ws.bike, d: 'Most trips are easy by bike.' },
  { k: 'Transit Score', v: ws.transit, d: 'Several transit options close by.' },
];
---
<section class="section manifesto" id="about">
  <div class="mani-body">
    <p class="mani-text" data-words>{c.idea?.body}</p>
    <p class="body mani-aside" data-reveal>
      {c.neighborhood?.intro}
    </p>
  </div>

  <div class="grid scores">
    {scores.map((s) => (
      <div class="cell score" data-reveal>
        <span class="label label--dim">{s.k}</span>
        <b class="score-num" data-count={s.v}>0</b>
        <i class="score-bar" style={`--v:${(s.v ?? 0) / 100}`} data-bar></i>
        <span class="small">{s.d}</span>
      </div>
    ))}
    <div class="cell score score--text" data-reveal>
      <span class="label label--dim">Where</span>
      <p class="h3">Seattle Center at the end of the block.</p>
      <span class="small">The Space Needle, MoPOP and Climate Pledge Arena are a short walk away.</span>
    </div>
  </div>
</section>

<style>
  .mani-body {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--gap);
    padding: clamp(56px, 8vw, 160px) var(--inset) clamp(48px, 6vw, 120px);
    border-top: 1px solid var(--line);
  }
  .mani-text { grid-column: 1 / span 10; font-size: clamp(1.9rem, 1.28rem + 3.1vw, 5rem); line-height: 1.04; letter-spacing: -0.03em; font-weight: 400; text-wrap: pretty; }
  .mani-text :global(.word) { display: inline-block; }
  .mani-aside { grid-column: 9 / span 4; margin-top: clamp(20px, 3vw, 48px); align-self: start; }
  .score { grid-column: span 3; display: grid; gap: 16px; align-content: start; min-height: clamp(200px, 17vw, 300px); }
  .score-num { font-size: var(--t-num); line-height: 0.9; letter-spacing: -0.05em; font-weight: 400; font-variant-numeric: tabular-nums; }
  .score-bar { display: block; height: 1px; background: var(--line); position: relative; }
  .score-bar::after { content: ''; position: absolute; inset: 0; background: var(--fg); transform: scaleX(var(--p, 0)); transform-origin: left; }
  .score--text { gap: 12px; }
  .score--text .h3 { font-weight: 400; max-width: 14ch; }
  @media (max-width: 1024px) {
    .mani-text { grid-column: 1 / -1; }
    .mani-aside { grid-column: 1 / span 8; }
    .scores { grid-template-columns: repeat(2, 1fr); }
    .score { grid-column: auto; }
  }
  /* .mani-body is twelve columns at every width, so an aside left on
     `span 8` was 8/12 of a 280px container on a phone — 187px, about 20
     characters a line. Below 700 it takes the row. Between 1024 and 1280 it
     gets five columns instead of four, where four was landing at 27ch. */
  @media (max-width: 1280px) { .mani-aside { grid-column: 8 / span 5; } }
  @media (max-width: 1024px) { .mani-aside { grid-column: 1 / span 8; } }
  @media (max-width: 700px) { .mani-aside { grid-column: 1 / -1; } }
  @media (max-width: 560px) { .scores { grid-template-columns: 1fr; } .score { min-height: 0; } }
</style>
