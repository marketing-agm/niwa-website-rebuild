---
// One viewer for the whole page. It is a <dialog> rather than a fixed div
// because the unit galleries live inside a dialog that is already showModal():
// anything not in the top layer renders underneath it, no matter the z-index.
// A second showModal() stacks above the first, and Esc closes the top one, so
// closing a picture returns you to the unit rather than out of it.
---
<dialog class="lbx" data-lbx aria-label="Photo viewer">
  <div class="lbx-bar">
    <span class="label lbx-count" data-lbx-count></span>
    <button type="button" class="dlg-close" data-lbx-close>Close ✕</button>
  </div>

  <figure class="lbx-stage">
    <img data-lbx-img alt="" />
    <figcaption class="lbx-cap">
      <span class="label" data-lbx-title></span>
      <span class="small" data-lbx-desc></span>
    </figcaption>
  </figure>

  <button type="button" class="lbx-nav lbx-prev" data-lbx-prev aria-label="Previous photo">←</button>
  <button type="button" class="lbx-nav lbx-next" data-lbx-next aria-label="Next photo">→</button>
</dialog>

<style>
  .lbx {
    border: 0; padding: 0; margin: 0;
    width: 100vw; height: 100dvh; max-width: none; max-height: none;
    background: var(--bg); color: var(--fg);
    display: none; grid-template-rows: auto 1fr;
  }
  .lbx[open] { display: grid; }
  .lbx::backdrop { background: rgba(0, 0, 0, 0.82); }

  .lbx-bar {
    display: flex; justify-content: space-between; align-items: center;
    gap: var(--gap); padding: 0 var(--inset); height: var(--nav-h);
    border-bottom: 1px solid var(--line);
  }
  .lbx-count { color: var(--fg-3); font-variant-numeric: tabular-nums; }

  .lbx-stage {
    margin: 0; min-height: 0; position: relative;
    display: grid; grid-template-rows: 1fr auto;
    padding: clamp(14px, 2vw, 34px) var(--inset) clamp(16px, 2vw, 30px);
    gap: 14px;
  }
  .lbx-stage img {
    min-height: 0; width: 100%; height: 100%;
    object-fit: contain; object-position: center;
  }
  .lbx-cap { display: grid; gap: 4px; justify-items: start; }
  .lbx-cap .small { color: var(--fg-2); max-width: 70ch; }

  /* Placed against the stage edges rather than floating over the picture, so
     they never sit on top of the thing you opened them to look at. */
  .lbx-nav {
    position: absolute; top: 50%; transform: translateY(-50%);
    width: clamp(46px, 3.2vw, 60px); height: clamp(46px, 3.2vw, 60px); border-radius: 999px;
    border: 1px solid var(--line);
    background: rgba(11, 11, 11, 0.7);
    color: var(--fg); font-size: var(--t-body);
    backdrop-filter: blur(6px);
    transition: border-color 0.3s, color 0.3s, background-color 0.3s;
  }
  .lbx-nav:hover { border-color: var(--gold); color: var(--gold); }
  .lbx-prev { left: clamp(8px, 1.4vw, 22px); }
  .lbx-next { right: clamp(8px, 1.4vw, 22px); }
  .lbx-nav[hidden] { display: none; }

  @media (max-width: 640px) {
    /* Every photo here is landscape and the phone is portrait, so `contain`
       can only ever fill about a third of the height. Going full-bleed
       horizontally buys back what little there is. The controls stay centred
       on the picture rather than being parked at a fixed offset from the
       bottom, where they read as floating in the empty half of the screen. */
    .lbx-stage { padding: 8px 0 14px; }
    .lbx-cap { padding-inline: var(--gutter); }
    .lbx-nav { width: 44px; height: 44px; }
    .lbx-prev { left: 10px; }
    .lbx-next { right: 10px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .lbx-stage img { transition: none; }
  }
</style>
