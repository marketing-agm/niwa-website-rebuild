---
import { Image } from 'astro:assets';
import { photo } from '../lib/photos';
const slugs = [
  'exterior-on-1st-ave-n', 'exterior-entrance', 'exterior-paseo', 'exterior-monument-sign',
  'interior-vestibule', 'interior-elevator-hall', 'interior-clubroom-terrace',
  'interior-clubroom-kitchen', 'exterior-terrace-walk', 'interior-fitness-room',
];
const items = slugs.map(photo);
---
{/* No heading. The strip is photographs of the building and its streets and
    says so by being them; a line introducing them was the page narrating
    itself. The section keeps a label for the accessibility tree, which is the
    one reader that cannot see what the pictures are. */}
<section class="section gallery" id="gallery" data-gallery aria-label="The building and the neighborhood, photographed">
  {/* Two modes, chosen once in motion.ts so the two scripts cannot disagree.
      On a desktop pointer the section pins and the strip scrubs sideways as
      you scroll down — the vertical wheel drives the horizontal travel, and
      the hairline under it fills as you go. On touch, on a narrow window, or
      for anyone who asked for reduced motion, it is an ordinary scroll
      container with the draggable bar below it: pinning hijacks the page's
      only scroll axis, which is the wrong thing to do to a phone and the
      wrong thing to do to someone who has asked motion to stop. */}
  <div class="gal-viewport" tabindex="0" role="group" aria-label="Photographs, scroll sideways" data-gal-vp>
    <div class="gal-track" data-gallery-track>
      {items.map((p) => (
        <figure class="gal-item" style={`--ar:${(p.img.width / p.img.height).toFixed(3)}`}>
          <div class="gal-img">
            <Image src={p.img} alt={p.alt} widths={[640, 960, 1440]} sizes="(max-width: 720px) 86vw, 60vh" format="webp" quality={76} loading="lazy" />
          </div>
        </figure>
      ))}
    </div>
    {/* Only drawn while pinned: it reports progress through the strip, which
        is the one thing you cannot otherwise tell when the page has stopped
        moving under you. */}
    <div class="gal-progress" aria-hidden="true"><i data-gallery-progress></i></div>
  </div>
  {/* Our own bar, not the browser's. Chromium ignores ::-webkit-scrollbar once
      the standard scrollbar properties are set, and what it gives instead is
      an overlay that takes a pixel of layout and fades out when you stop —
      which is not a bar you can reach for. This one is always there, sized to
      the share of the strip on screen, and can be dragged. The thumb is in
      the markup rather than built in script, because scoped styles never
      reach an element JavaScript creates. */}
  <div class="gal-bar" data-gal-bar>
    <div class="gal-thumb" data-gal-thumb role="scrollbar" tabindex="0"
         aria-controls="gallery" aria-orientation="horizontal" aria-label="Scroll the photographs"></div>
  </div>
</section>

<style>
  .gal-viewport {
    position: relative; border-top: 1px solid var(--line);
    padding: var(--gap) 0 calc(var(--gap) + 6px);
    overflow-x: auto; overflow-y: hidden;
    scrollbar-width: none;
  }
  /* Pinned: nothing scrolls natively, the track is moved by transform. */
  .gallery.is-pinned .gal-viewport { overflow: hidden; padding-bottom: calc(var(--gap) + 14px); }
  .gallery.is-pinned .gal-bar { display: none; }
  .gal-progress { display: none; }
  .gallery.is-pinned .gal-progress {
    display: block; position: absolute; left: var(--gutter); right: var(--gutter);
    bottom: 0; height: 1px; background: var(--line);
  }
  .gal-progress i { display: block; height: 100%; background: var(--fg); transform: scaleX(0); transform-origin: left; }
  .gal-viewport::-webkit-scrollbar { display: none; }
  /* Keyboard: the strip is focusable, so arrow keys scroll it. Without the
     outline there is no way to tell that focus has landed there. */
  .gal-viewport:focus-visible { outline: 1px solid var(--gold); outline-offset: -1px; }

  /* 8px of bar inside a 22px hit strip: the bar reads as a hairline against
     the photographs, but a hairline is not something you can catch with a
     pointer. The padding is the target; the bar is the drawing. */
  /* Short and centred, not full-bleed. At the full width of the page, pinned
     under the strip, this read as the browser's own horizontal scrollbar
     rather than as a control belonging to the gallery — it got reported as a
     page bug twice. A track that stops well short of both edges and sits in
     the middle cannot be mistaken for chrome, and it is a shorter throw to
     drag. */
  .gal-bar {
    position: relative;
    width: min(420px, calc(100% - var(--gutter) * 2));
    margin: clamp(18px, 1.6vw, 28px) auto 0;
    padding: 7px 0;
    cursor: pointer;
  }
  .gal-bar::before { content: ''; display: block; height: 8px; background: var(--line-2); border-radius: 4px; }
  .gal-thumb { position: absolute; top: 7px; height: 8px; width: 20%; background: var(--fg-2); border-radius: 4px; cursor: grab; transition: background-color 0.2s; }
  @media (hover: hover) { .gal-thumb:hover { background: var(--fg); } }
  .gal-thumb:focus-visible { outline: 1px solid var(--gold); outline-offset: 2px; }
  .gal-bar.is-dragging .gal-thumb { background: var(--fg); cursor: grabbing; }
  /* A finger has the photographs themselves to push, and a 4px target is not
     one. The bar stays as the indicator; dragging is a pointer affordance. */
  @media (pointer: coarse) { .gal-thumb { cursor: default; } }
  .gal-track { display: flex; gap: var(--gap); padding: 0 var(--gutter); width: max-content; will-change: transform; }
  /* The pictures carry no captions; the room name lives in the alt text so
     screen readers still get it. One child, so no track gap to reserve. */
  .gal-item { --h: clamp(280px, 60vh, 760px); display: block; flex: 0 0 auto; width: calc(var(--h) * var(--ar)); max-width: calc(100vw - var(--gutter) * 2); }
  .gal-img { height: var(--h); overflow: hidden; background: var(--bg-2); }
  .gal-img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 720px) { .gal-item { --h: clamp(240px, 48vh, 420px); } }
</style>

