---
import Analytics from '../components/Analytics.astro';
import TourDialog from '../components/TourDialog.astro';
import '../styles/global.css';

const { site } = Astro.props as { site: { id: string; config: any; data: any; faq?: { q: string; a: string }[] } };
const c = site.config;
const url = c.domain.replace(/\/$/, '') + '/';

// Price range is derived from live availability, not hand-maintained — a static
// schema.priceRange drifts the moment rents move. Scoped to move-in-ready homes.
const allUnits: any[] = site.data?.units ?? [];
const nowUnits = allUnits.filter((u: any) => u.availType === 'now');
const rentScope = nowUnits.length ? nowUnits : allUnits;
const liveRents: number[] = rentScope.map((u: any) => Number(u.rent)).filter((n: number) => Number.isFinite(n) && n > 0);
const money = (n: number) => '$' + n.toLocaleString('en-US');
const priceRange = liveRents.length
  ? (Math.min(...liveRents) === Math.max(...liveRents)
      ? `${money(Math.min(...liveRents))}/mo`
      : `${money(Math.min(...liveRents))}–${money(Math.max(...liveRents))}/mo`)
  : c.schema.priceRange;

const alternateName: string[] = c.seo.alternateNames ?? [];
const sameAs: string[] = c.seo.sameAs ?? [];
const officeHours: any[] = c.contact.officeHours ?? [];

const jsonLd: any = {
  '@context': 'https://schema.org',
  '@type': c.schema.type,
  '@id': url + '#property',
  name: c.name,
  description: c.schema.description,
  url,
  telephone: c.contact.phone,
  priceRange,
  address: {
    '@type': 'PostalAddress',
    streetAddress: c.address.streetAddress,
    addressLocality: c.address.addressLocality,
    addressRegion: c.address.addressRegion,
    postalCode: c.address.postalCode,
    addressCountry: c.address.addressCountry,
  },
  areaServed: (c.schema.areaServed || []).map((name: string) => ({ '@type': 'Place', name })),
  containedInPlace: { '@type': 'Place', name: c.schema.containedInPlace },
  numberOfBedrooms: c.schema.numberOfBedrooms,
  petsAllowed: c.schema.petsAllowed,
  amenityFeature: (c.schema.amenityFeature || []).map((name: string) => ({ '@type': 'LocationFeatureSpecification', name, value: true })),
};
if (c.geo && c.geo.latitude != null && c.geo.longitude != null) {
  jsonLd.geo = { '@type': 'GeoCoordinates', latitude: c.geo.latitude, longitude: c.geo.longitude };
}
if (alternateName.length) jsonLd.alternateName = alternateName;
if (sameAs.length) jsonLd.sameAs = sameAs;
if (c.contact.email) jsonLd.email = c.contact.email;
if (officeHours.length) {
  jsonLd.openingHoursSpecification = officeHours.map((h: any) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: h.days, opens: h.opens, closes: h.closes }));
}

const faqItems = site.faq || [];
const stripTags = (s: string) => s.replace(/<[^>]+>/g, ' ').replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/\s+/g, ' ').trim();
const faqJsonLd = faqItems.length
  ? { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqItems.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: stripTags(f.a) } })) }
  : null;

// Design tokens a site can override from config. `:root:root` outranks the
// stylesheet's own :root so config always wins.
const themeVars = Object.entries(c.theme?.colors ?? {}).map(([k, v]) => `${k}: ${v};`).join(' ');

// What the client scripts need: identity, contact and integrations. Nothing else.
const siteRuntime = {
  id: site.id,
  config: { name: c.name, address: c.address, integrations: c.integrations, contact: c.contact },
};
const emailjsConfigured = !!(c.integrations?.emailjs?.publicKey && c.integrations.emailjs.serviceId && c.integrations.emailjs.templateId);
---
<!DOCTYPE html>
<html lang={c.lang}>
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<title>{c.seo.title}</title>
<meta name="description" content={c.seo.description} />
<meta name="keywords" content={c.seo.keywords} />
<meta name="robots" content={c.seo.noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
<meta name="author" content={c.seo.author} />
<link rel="canonical" href={url} />
{c.seo.verification?.google && <meta name="google-site-verification" content={c.seo.verification.google} />}
{c.seo.verification?.bing && <meta name="msvalidate.01" content={c.seo.verification.bing} />}
<meta name="geo.region" content={c.address.geoRegion} />
<meta name="geo.placename" content={c.address.placename} />
{c.geo?.latitude != null && <meta name="geo.position" content={`${c.geo.latitude};${c.geo.longitude}`} />}
{c.geo?.latitude != null && <meta name="ICBM" content={`${c.geo.latitude}, ${c.geo.longitude}`} />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={c.name} />
<meta property="og:title" content={c.seo.title} />
<meta property="og:description" content={c.seo.description} />
<meta property="og:url" content={url} />
<meta property="og:locale" content={c.locale} />
{c.seo.ogImage && <meta property="og:image" content={new URL(c.seo.ogImage, c.domain).href} />}
{c.seo.ogImage && <meta property="og:image:alt" content={c.hero?.alt || `${c.name} apartments`} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={c.seo.title} />
<meta name="twitter:description" content={c.seo.twitterDescription || c.seo.description} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content={c.theme?.themeColor ?? '#0b0b0b'} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
{faqJsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} />}
<link rel="preload" href="/fonts/inter-tight-latin.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/geist-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
{themeVars && <style is:inline set:html={`:root:root{${themeVars}}`} />}
<script is:inline set:html={`window.__SITE__=${JSON.stringify(siteRuntime)};`} />
{emailjsConfigured && <script is:inline src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js" defer></script>}
<Analytics site={site} />
</head>
<body>
<slot />
<TourDialog />
<script>
  import '../scripts/motion.ts';
  import '../scripts/tour.ts';
</script>
</body>
</html>
