---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Manifesto from '../components/Manifesto.astro';
import Building from '../components/Building.astro';
import Homes from '../components/Homes.astro';
import SiteMap from '../components/SiteMap.astro';
import Neighborhood from '../components/Neighborhood.astro';
import Gallery from '../components/Gallery.astro';
import Faq from '../components/Faq.astro';
import Tour from '../components/Tour.astro';
import Footer from '../components/Footer.astro';
import { getSite } from '../lib/site';

const site = getSite();
const c = site.config;
const a = c.address;
const marquee: string[] = [
  ...(c.marquee ?? []),
  `${a.streetAddress}, ${a.addressLocality}`,
  'Pet friendly',
  'MFTE homes available',
];
---
<BaseLayout site={site}>
  <Nav site={site} />
  <main id="main">
    <Hero site={site} />
    <Marquee items={marquee} />
    <Manifesto site={site} />
    <Building site={site} />
    <Homes site={site} />
    <SiteMap site={site} />
    <Neighborhood site={site} />
    <Gallery site={site} />
    <Faq site={site} />
    <Tour site={site} />
  </main>
  <Footer site={site} />
</BaseLayout>
